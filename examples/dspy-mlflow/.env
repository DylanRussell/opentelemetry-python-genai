# Required for DSPy Gemini models (via LiteLLM)
GEMINI_API_KEY="your-gemini-api-key"

# MLflow tracking and GenAI semantic conventions configuration
MLFLOW_TRACKING_URI="sqlite:///mlruns.db"
MLFLOW_EXPERIMENT_NAME="dspy-gemini-observability"

# OpenTelemetry OTLP Exporter Endpoint for GCP Cloud Trace
GCP_PROJECT_ID="ai-observability-cco-demo"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="https://telemetry.googleapis.com:443/v1/traces"
OTEL_SERVICE_NAME="dspy-gemini-mlflow"

MODEL="gemini/gemini-1.5-flash"
PROMPT="Why is the sky blue?"
