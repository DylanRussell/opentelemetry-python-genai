# =============================================================================
# Google Cloud & Authentication
# =============================================================================
# Required: The Google Cloud project ID to which traces will be sent.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Path to a service account JSON file.
# If commented out, google-auth falls back to Application Default Credentials (ADC),
# such as credentials configured via `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =============================================================================
# Gemini Model Authentication
# =============================================================================
# Option A: Gemini Developer API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Option B: Vertex AI (uses GCP project and ADC)
# Uncomment the two lines below to route Gemini requests through Vertex AI instead:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=us-central1

# =============================================================================
# OpenTelemetry Configuration
# =============================================================================
# Service name displayed in Google Cloud Trace
OTEL_SERVICE_NAME=basic-adk-agent

# Optional resource attributes (comma-separated key=value pairs)
OTEL_RESOURCE_ATTRIBUTES=service.namespace=demo,service.version=0.1.0

# Optional: Capture message content in spans and events (one of SPAN_ONLY, EVENT_ONLY, SPAN_AND_EVENT)
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=span_and_event

# =============================================================================
# Agent Configuration
# =============================================================================
ADK_MODEL=gemini-2.5-flash
ADK_PROMPT=Explain quantum computing in two sentences.
